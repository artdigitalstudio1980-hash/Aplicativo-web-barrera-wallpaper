# Database Configuration - MySQL (Hostinger)
# Get this from Hostinger Panel → Databases → Your Database
# Format: mysql://username:password@host:port/database
# Example: mysql://u425976741_barrera:YourPassword@localhost:3306/u425976741_barrera
DATABASE_URL="mysql://username:password@localhost:3306/database_name"

# NextAuth Configuration
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="https://yourdomain.com"

# OpenAI API (for AI wallpaper generation)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-..."

# Pictorem API (for dropshipping wallpaper printing)
# Contact Pictorem for API access
PICTOREM_API_KEY="your-pictorem-api-key"
PICTOREM_API_URL="https://api.pictorem.com"

# Stripe Payment (optional - for online payments)
# Get from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# PayPal Payment (optional - for online payments)
# Get from: https://developer.paypal.com/dashboard/applications
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
PAYPAL_MODE="sandbox" # Change to "live" for production

# AWS S3 (optional - for file uploads)
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="your-bucket-name"
AWS_FOLDER_PREFIX="barrera-wallpaper/"

# Email Configuration (optional - for contact form)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"
EMAIL_FROM="noreply@barrerawallpaper.com"

# Application Configuration
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
