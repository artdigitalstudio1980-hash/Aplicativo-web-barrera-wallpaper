# Database
DATABASE_URL="postgresql://user:password@host:port/database?pgbouncer=true&connection_limit=1"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here-min-32-chars"
NEXTAUTH_URL="https://barrerawallpaper.com"

# OpenAI API (DALL-E 3)
OPENAI_API_KEY="sk-..."

# Google AI Studio (Nano Banana - Gemini 2.5 Flash)
GOOGLE_AI_STUDIO_API_KEY="your_google_ai_studio_api_key_here"

# Pictorem API
PICTOREM_API_KEY="your-pictorem-api-key"
PICTOREM_API_URL="https://api.pictorem.com/v1"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# PayPal
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
PAYPAL_MODE="sandbox"

# AWS S3 (para almacenamiento de imágenes)
AWS_BUCKET_NAME="your-bucket-name"
AWS_FOLDER_PREFIX="barrera-wallpaper/"